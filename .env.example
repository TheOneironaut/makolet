# Local-development defaults only. Copy this file to .env before running Compose.
# Production mode rejects every bundled credential containing "development".
# MAKOLET_BIND_ADDRESS controls only the API and optional monitoring host ports;
# PostgreSQL and S3 remain loopback-only. Store non-local secrets outside source control.
MAKOLET_ENVIRONMENT=development
MAKOLET_BIND_ADDRESS=127.0.0.1
MAKOLET_API_PORT=8000
MAKOLET_POSTGRES_PORT=5432
MAKOLET_S3_PORT=8333
MAKOLET_PROMETHEUS_PORT=9090

POSTGRES_USER=makolet
POSTGRES_PASSWORD=makolet-development-only-change-me
POSTGRES_DB=makolet
MAKOLET_DATABASE_URL=postgresql://makolet:makolet-development-only-change-me@postgres:5432/makolet
# Development Compose uses plaintext on its private backend network. In production this
# exception is honored only for a literal loopback IP; service labels require verify-full.
MAKOLET_DATABASE_ALLOW_INSECURE_LOCAL=true

# These are development-only S3 credentials. SeaweedFS creates the bucket at startup.
MAKOLET_S3_ACCESS_KEY=makolet-development
MAKOLET_S3_SECRET_KEY=makolet-development-only-change-me
MAKOLET_S3_BUCKET=makolet-raw
MAKOLET_S3_REGION=us-east-1
MAKOLET_S3_ENDPOINT=http://seaweedfs:8333
# Development Compose uses plaintext on its private backend network. In production this
# exception is honored only for a literal loopback IP and requires path-style addressing;
# service labels and other remote endpoints require HTTPS.
MAKOLET_S3_ALLOW_INSECURE_LOCAL=true
MAKOLET_S3_KEY_PREFIX=raw
MAKOLET_S3_PATH_STYLE=true
MAKOLET_ARCHIVE_MAXIMUM_OBJECT_BYTES=2147483648
MAKOLET_ARCHIVE_MINIMUM_FREE_BYTES=1073741824

# A conservative public-source cadence. Remove the source or lengthen the interval
# before first start if you do not want an immediate low-volume listing request.
MAKOLET_ENABLED_SOURCES=["shufersal"]
MAKOLET_SOURCE_INTERVALS_SECONDS={"shufersal":21600}
MAKOLET_INGESTION_DISCOVERY_PAGE_SIZE=25
MAKOLET_INGESTION_MAXIMUM_FILES_PER_SOURCE_RUN=100
MAKOLET_INGESTION_MAXIMUM_CHARGED_BYTES_PER_SOURCE_RUN=4294967296
MAKOLET_INGESTION_MAXIMUM_CHARGED_BYTES_PER_SOURCE_DAY=8589934592
MAKOLET_INGESTION_MAXIMUM_SOURCE_IDENTITIES_PER_SOURCE_DAY=2000
MAKOLET_INGESTION_MAXIMUM_TRANSFER_ATTEMPTS_PER_SOURCE_DAY=4000
MAKOLET_INGESTION_MAXIMUM_SUCCESSES_PER_SOURCE_DAY=2000
MAKOLET_INGESTION_MAXIMUM_VALIDATION_ISSUES=100000
MAKOLET_INGESTION_MAXIMUM_VALIDATION_ISSUE_BYTES=67108864
MAKOLET_INGESTION_MAXIMUM_VALIDATION_ISSUE_EVIDENCE=1000
MAKOLET_MCP_HTTP_BODY_TIMEOUT_SECONDS=10
MAKOLET_MCP_HTTP_MAXIMUM_CONCURRENCY=100
MAKOLET_WORKER_CONCURRENCY=2
MAKOLET_WORKER_QUEUE_CAPACITY=16
MAKOLET_WORKER_SHUTDOWN_GRACE_SECONDS=45
# Plain FTP has no transport authenticity and stays disabled unless an operator
# explicitly accepts that risk for a configured NCR source.
MAKOLET_ALLOW_INSECURE_FTP=false
MAKOLET_LOG_LEVEL=INFO
